// 比较用归一（与 shared kpNorm 同口径：去空白、统一破折号、去括号/冒号）
function kpNorm(s: string): string {
  return String(s || '').replace(/\s+/g, '').replace(/[—–-]/g, '—').replace(/[（）()：:]/g, '')
}

