const sections = TEXTBOOK_SECTIONS
const S = new Set(sections)
const normMap = new Map<string, string>(sections.map((s) => [kpNorm(s), s]))

// 单个标签 → 规范节名（null = 无法归一，保留原样）
function mapKp(k: string): string | null {
  if (S.has(k)) return null // 已是节名
  if (KP_ALIASES[k]) return KP_ALIASES[k]
  const nk = kpNorm(k)
  if (!nk) return null
  if (normMap.has(nk)) return normMap.get(nk)!
  const cands = sections.filter((s) => {
    const ns = kpNorm(s)
    return ns.includes(nk) || nk.includes(ns)
  })
  if (cands.length === 1) return cands[0]
  return null
}

// 个别题的整表人工定标（变体名无法唯一归节，逐题看过题干后手工指定最终标签）
const MANUAL_FIX: Record<number, string[]> = {
  7: ['共点力平衡（解析法）', '滑动摩擦力'],
  9: ['共点力平衡（解析法）', '滑动摩擦力'],
  10: ['共点力平衡（解析法）', '力矩平衡'],
  11: ['共点力平衡（图解法/矢量三角形）'],
  30: ['共点力平衡（图解法/矢量三角形）', '综合专题：斜面上的平衡问题'],
  142: ['楞次定律与右手定则'],
}

const db = new Database(path.join(ROOT, 'data', 'app.db'))
const rows = db.prepare('SELECT id, knowledge_points FROM questions ORDER BY id').all() as any[]
const upd = db.prepare('UPDATE questions SET knowledge_points = ? WHERE id = ?')

let changedQ = 0
let replacedTags = 0
const beforeVariants = new Set<string>()
const afterVariants = new Set<string>()
const noCanonical: number[] = []
const detail: string[] = []

for (const r of rows) {
  let dbKps: string[] = []
  try { dbKps = JSON.parse(r.knowledge_points || '[]') } catch { /* 跳过脏数据 */ continue }
  const kps = MANUAL_FIX[r.id] ?? dbKps
  for (const k of kps) if (!S.has(k)) beforeVariants.add(k)
  const seen = new Set<string>()
  const next: string[] = []
  const chg: string[] = []
  for (const k of kps) {
    const mapped = mapKp(k)
    const out = mapped ?? k
    const key = kpNorm(out)
    if (!key || seen.has(key)) continue
    seen.add(key)
    next.push(out)
    if (mapped) { chg.push(`${k}→${mapped}`); replacedTags++ }
  }
  if (!next.some((k) => S.has(k) || normMap.has(kpNorm(k)))) noCanonical.push(r.id)
  for (const k of next) if (!S.has(k)) afterVariants.add(k)
  if (chg.length || JSON.stringify(next) !== JSON.stringify(dbKps)) {
    changedQ++
    detail.push(`#${r.id}: ${chg.length ? chg.join('；') : '人工定标 ' + JSON.stringify(dbKps) + ' → ' + JSON.stringify(next)}`)
    if (!DRY) upd.run(JSON.stringify(next), r.id)
  }
}

console.log(`题目总数 ${rows.length}；变更 ${changedQ} 题；替换标签 ${replacedTags} 个${DRY ? '（dry-run 未写库）' : ''}`)
console.log(`节名外变体标签：${beforeVariants.size} → ${afterVariants.size}`)
console.log(`无任何规范节名的题目：${noCanonical.length}${noCanonical.length ? ' → #' + noCanonical.join(' #') : ''}`)
console.log('--- 变更明细 ---')
console.log(detail.join('\n'))
